# SDPS WhatsApp (Baileys) microservice — copy to `.env` and fill in.

# HTTP port the service listens on.
PORT=3001

# Shared secret — MUST match the backend's WA_API_SECRET. Use a strong random value.
WA_API_SECRET=your_whatsapp_service_secret_here

# Directory where the Baileys auth/session state is persisted (mount a volume
# here in production so the QR link survives restarts).
WA_AUTH_DIR=./auth_state

# Delay between bulk messages, in ms (2s default to reduce WhatsApp ban risk).
WA_BULK_DELAY_MS=2000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=warn

# ── Keep-alive (prevents Render free instances from idling) ──
KEEPALIVE_INTERVAL_SEC=720
# Public URL of this service (Render sets RENDER_EXTERNAL_URL automatically).
# SELF_URL=https://your-whatsapp-service.onrender.com
# Backend URL to ping so it also stays warm.
# BACKEND_URL=https://sdps-website-main.onrender.com
