# SDPS frontend environment — copy to `.env` (dev) / `.env.production` (build).

# CRA build flags
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true
INLINE_RUNTIME_CHUNK=false

# Backend API base URL(s). The app tries these in order and pins the one that
# responds, so the fallback is used if the primary is down.
# (Used by src/lib/api.js and injected into the QP portal config.js at build.)
REACT_APP_BACKEND_URL=https://sdps-website-main.onrender.com
REACT_APP_BACKEND_FALLBACK=
