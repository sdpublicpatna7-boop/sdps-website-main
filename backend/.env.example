# ─────────────────────────────────────────────────────────────────────────────
# SDPS backend environment — copy to `.env` and fill in real values.
# NEVER commit the real `.env` (it is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=YourApp
DB_NAME=sdps_portal

# ── Auth / JWT ──
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-strong-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Cookies ──
# Use COOKIE_SECURE=false only for local http dev; true in production (HTTPS).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── CORS (comma-separated allowed origins) ──
CORS_ORIGINS=https://sdpublic.org,https://www.sdpublic.org

# ── Seed accounts (created on first run; change before real use) ──
ADMIN_SEED_EMAIL=admin@sdpublic.org
ADMIN_SEED_PASSWORD=change-me
STAFF_SEED_EMAIL=staff@sdpublic.org
STAFF_SEED_PASSWORD=change-me
QP_ADMIN_USERNAME=qpadmin
QP_ADMIN_PASSWORD=change-me

# ── QP portal (question paper) ──
QP_PORTAL_URL=https://sdpublic.org/qp-portal/
QP_JWT_EXPIRY_HOURS=12
QP_OTP_TTL_MIN=10
# Set true in dev to log OTPs to the console instead of requiring WhatsApp.
QP_OTP_DEBUG=false

# ── Admission ──
ADMISSION_REG_FEE_INR=500

# ── Razorpay (alumni membership + admission registration) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Email (MailerCloud) ──
MAILERCLOUD_API_KEY=
SENDER_EMAIL=noreply@sdpublic.org
SENDER_NAME=S.D. Public School

# ── SMS (BulkSMS) ──
BULKSMS_API_URL=
BULKSMS_API_KEY=
BULKSMS_SENDER_ID=SDPUBP
BULKSMS_TEMPLATE_ID=

# ── ERP ──
ERP_LOGIN_URL=https://sdpublic.gungunerp.in

# ── AI Assist (free Google Gemini key: https://aistudio.google.com/app/apikey) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── WhatsApp (Baileys) microservice ──
WA_SERVICE_URL=http://localhost:3001
WA_API_SECRET=must-match-the-whatsapp-service-secret
WA_BULK_DELAY_MS=2000
WA_MAX_MEDIA_MB=16

# Online fee-payment portal (parents enter the child's admission number).
FEE_PAY_URL=https://sdps.gungunerp.in/pay-fees

# ── Keep-alive (prevents Render free instances from idling) ──
KEEPALIVE_INTERVAL_SEC=720
# Set automatically by Render; or set SELF_URL manually for other hosts.
# RENDER_EXTERNAL_URL=https://your-backend.onrender.com

# ── Cloudinary (optional - dynamic cloud media hosting for uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

